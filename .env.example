# Copy to .env on the server (chmod 600, owned by the app user). Never commit .env.
# Generate SECRET_KEY / MASTER_KEY_V1 / INDEX_KEY with:  venv/bin/python manage.py genkeys

APP_ENV=production
DATABASE_URL=postgresql://csp_app:CHANGE_ME@127.0.0.1:5432/csp_onboarding?sslmode=prefer

SECRET_KEY=
KEK_VERSION=1
MASTER_KEY_V1=
INDEX_KEY=

# Public address of the app (used in links and alerts)
PUBLIC_BASE_URL=https://indev.eko.in
DEFAULT_PROGRAM_SLUG=esaf-csp

# Where encrypted uploads and generated documents are stored
STORAGE_DIR=/srv/csp-onboarding/data/objects

# Google sign-in (Google Cloud Console → APIs & Services → Credentials → OAuth client ID, type "Web application")
# Authorised redirect URI: https://indev.eko.in/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Session lifetime
SESSION_HOURS=8
SESSION_IDLE_MINUTES=30

# Telegram alerts to the RM/admin group (optional): create a bot with @BotFather, add it to the group
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Virus scanning with ClamAV (install clamav-daemon on the server, then set to 1)
CLAMAV_ENABLED=0
MAX_UPLOAD_MB=15

# Local testing only: lets you sign in without Google from the same computer. Never set on the server.
# APP_ENV=development
# DEV_LOGIN=1
